{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "@cloudflare/workers-types",
      "vinext/types",
      "vite/client"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/erp-config": ["./erp-config.ts"],
      "@/erp-admin/*": ["./erp-admin/*"],
      "@/erp-includes/*": ["./erp-includes/*"],
      "@/erp-content/*": ["./erp-content/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "_archive_pre_rebuild",
    "dist",
    ".next",
    ".vinext"
  ]
}
